# dependencies
node_modules/

# Build output is committed on purpose. The plugin catalogue generates the
# scope-less command `dsh plugin add Ragnoryok1/dsh-client-locale-ru`, which pnpm
# resolves as a GitHub archive; pnpm refuses to run a git dependency's build
# scripts (ERR_PNPM_GIT_DEP_PREPARE_NOT_ALLOWED), so the package has to arrive
# already built. `npm publish` rebuilds `lib/` through prepublishOnly.
*.tsbuildinfo

# packaged archive
*.tgz

# One lock file is canonical: `package-lock.json`, because CI installs with npm
# and the published plugin has to match what CI verified. A pnpm lock beside it
# is a local artifact of whichever tool was tried last, not a second truth.
pnpm-lock.yaml
package-lock.yaml

# Written by scripts/watch-upstream.mjs for the issue it opens.
upstream-report.md

# local env / credentials — never commit
.env
.env.local
.npmrc

# logs
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
