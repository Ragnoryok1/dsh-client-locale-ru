{
  "name": "@ragnoryok1/dsh-client-locale-ru",
  "description": "Russian (ru) language pack for the dsh web GUI, registered as an external client language",
  "version": "0.1.6",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "cordis-plugin",
    "localization",
    "localisation",
    "language-pack",
    "i18n",
    "l10n",
    "russian",
    "ru"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ragnoryok1/dsh-client-locale-ru.git"
  },
  "homepage": "https://github.com/Ragnoryok1/dsh-client-locale-ru#readme",
  "bugs": {
    "url": "https://github.com/Ragnoryok1/dsh-client-locale-ru/issues"
  },
  "author": "Ragnoryok1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.2 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.2 <0.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib/",
    "images/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
